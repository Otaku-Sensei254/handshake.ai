# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxxxxxx-pooler.c-4.us-east-2.aws.neon.tech:6543/handshake.ai?sslmode=require&channel_binding=require

# ─── AI / Enrichment ────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=1536

# ─── Telegram Bot ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# ─── Voice / ElevenLabs ─────────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_AGENT_ID=your_convai_agent_id

# ─── Matching config ────────────────────────────────────────────────────────
MATCH_SCORE_THRESHOLD=0.72
MATCH_CRON_SCHEDULE=0 */2 * * *
SIMILARITY_THRESHOLD=0.65
SIMILARITY_CANDIDATE_COUNT=5

# ─── Base URL ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
